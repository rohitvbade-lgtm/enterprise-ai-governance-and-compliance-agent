      "isDeleted": false,
      "boundElements": [],
      "updated": 1790660852894,
      "link": null,
      "locked": false,
      "text": "4. GovernanceAssessment (1) ────< (N) ApprovalRequest : Cascade delete. Created automatically when decision == 'REVIEW'.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. GovernanceAssessment (1) ────< (N) ApprovalRequest : Cascade delete. Created automatically when decision == 'REVIEW'.",
