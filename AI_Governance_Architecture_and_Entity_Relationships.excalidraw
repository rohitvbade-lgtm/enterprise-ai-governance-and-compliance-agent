      "updated": 1790660852895,
      "link": null,
      "locked": false,
      "text": "PII Masking Pipeline:\n• PIIDetector.mask(text) runs BEFORE LLM call.\n• Replaces detected tokens with [TYPE_REDACTED].\n• The DB persists ONLY the redacted text.\n• evaluated_text_redacted=True flag set.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
