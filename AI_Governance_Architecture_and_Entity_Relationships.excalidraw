    {
      "id": "txt_32996",
      "type": "text",
      "x": 1845,
      "y": 2325,
      "width": 502.15000000000003,
      "height": 96.25,
      "angle": 0,
      "strokeColor": "#065f46",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 33015,
      "version": 2,
      "versionNonce": 1763257474,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790660852895,
      "link": null,
      "locked": false,
      "text": "• Validates input_assessment_id foreign key integrity\n• Persists GovernanceAssessment record (stores masked text, flags, decision)\n• Persists RiskAssessment record (stores dimensional scores & factors_detail JSONB)\n• Bulk inserts all Finding records linked to assessment_id\n• If approval_required → creates ApprovalRequest record with status='PENDING'\n• Appends immutable AuditEvent (event_type='ASSESSMENT_COMPLETED')\n• Returns: {assessment_id: UUID, approval_request_id: UUID | None}",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Validates input_assessment_id foreign key integrity\n• Persists GovernanceAssessment record (stores masked text, flags, decision)\n• Persists RiskAssessment record (stores dimensional scores & factors_detail JSONB)\n• Bulk inserts all Finding records linked to assessment_id\n• If approval_required → creates ApprovalRequest record with status='PENDING'\n• Appends immutable AuditEvent (event_type='ASSESSMENT_COMPLETED')\n• Returns: {assessment_id: UUID, approval_request_id: UUID | None}",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b83"
    },
