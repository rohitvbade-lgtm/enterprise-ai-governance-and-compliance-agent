      "isDeleted": false,
      "boundElements": [],
      "updated": 1790660852894,
      "link": null,
      "locked": false,
      "text": "1. AIApplication (1) ────< (N) GovernanceAssessment : Cascade delete. Every audit is bound to an application context.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. AIApplication (1) ────< (N) GovernanceAssessment : Cascade delete. Every audit is bound to an application context.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b5k"
    },
    {
      "id": "txt_24902",
      "type": "text",
      "x": 100,
      "y": 2219,
      "width": 1011.8399999999999,
      "height": 15,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 24921,
      "version": 2,
      "versionNonce": 1766800962,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790660852894,
      "link": null,
      "locked": false,
      "text": "2. GovernanceAssessment (1) ──── (1) RiskAssessment : 1-to-1 unique relationship. Exactly one deterministic score record per assessment.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. GovernanceAssessment (1) ──── (1) RiskAssessment : 1-to-1 unique relationship. Exactly one deterministic score record per assessment.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b5l"
    },
    {
      "id": "txt_24959",
      "type": "text",
      "x": 100,
