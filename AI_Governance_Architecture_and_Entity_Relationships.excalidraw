      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 24978,
      "version": 2,
      "versionNonce": 83640030,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790660852894,
      "link": null,
      "locked": false,
      "text": "3. GovernanceAssessment (1) ────< (N) Finding : Cascade delete. Granular evidence findings emitted by Privacy, Security, or Policy agents.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. GovernanceAssessment (1) ────< (N) Finding : Cascade delete. Granular evidence findings emitted by Privacy, Security, or Policy agents.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b5m"
    },
    {
