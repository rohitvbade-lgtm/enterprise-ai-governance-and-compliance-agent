      "boundElements": [],
      "updated": 1790660852894,
      "link": null,
      "locked": false,
      "text": "pgvector Cosine Distance Query Syntax:\nSELECT pc.chunk_text, 1 - (pc.embedding <=> CAST(:embedding AS vector))\nAS similarity FROM policy_chunks pc WHERE pc.active = true\nORDER BY pc.embedding <=> CAST(:embedding AS vector) LIMIT :top_k",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "pgvector Cosine Distance Query Syntax:\nSELECT pc.chunk_text, 1 - (pc.embedding <=> CAST(:embedding AS vector))\nAS similarity FROM policy_chunks pc WHERE pc.active = true\nORDER BY pc.embedding <=> CAST(:embedding AS vector) LIMIT :top_k",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b69"
    },
